# Review API base URL (no trailing slash). Local: python scripts/claimguard/local_review_api.py --port 8788
VITE_API_URL=http://127.0.0.1:8788
# Local only: show the role/party picker and send X-Dev-Role / X-Dev-Party headers. Never set in prod.
VITE_DEV_AUTH=1
# Cognito (stage pool owned by the ChainTrack stack). Leave empty with VITE_DEV_AUTH=1.
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
